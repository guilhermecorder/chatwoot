<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CEVICO — Cuidados Oculares | Comece por aqui</title>
  <meta name="description" content="<%= @hub['tagline'].presence || 'CEVICO — Cuidados Oculares: cirurgia refrativa, cirurgia de catarata e lentes trifocais. Tecnologia de ponta, acolhimento humano e clareza visual.' %>">
  <link rel="canonical" href="<%= Cevico::PublicSite.base_url %>/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="CEVICO — Cuidados Oculares">
  <meta property="og:description" content="<%= @hub['tagline'].presence || 'Cirurgia refrativa, catarata e lentes trifocais — comece por aqui.' %>">
  <meta property="og:site_name" content="CEVICO — Cuidados Oculares">
  <meta property="og:url" content="<%= Cevico::PublicSite.base_url %>/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&display=swap" rel="stylesheet">
  <style>
    /* Identidade CEVICO: azul marinho EXATO do logo (#152C61) + dourado */
    :root { --navy: #152C61; --navy-deep: #0C1B40; --brand: #0F5FA6; --gold: #D4AF37; --gold-soft: #F4DE8E; --gold-dark: #8A6620; --gold-mid: #C9A24B; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1a2333; background: #f6f8fb; line-height: 1.65;
    }
    .hero {
      background: linear-gradient(160deg, var(--navy-deep) 0%, var(--navy) 55%, var(--brand) 100%);
      color: #fff; padding: 56px 20px 130px; text-align: center; position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: -40% -20% auto; height: 130%;
      background: radial-gradient(ellipse at 50% 0%, rgba(212,175,55,.14), transparent 60%);
      pointer-events: none;
    }
    .hero img { max-width: 280px; width: 70%; height: auto; margin-bottom: 18px; position: relative; }
    .hero p { opacity: .88; max-width: 600px; margin: 0 auto 26px; font-size: 1.05rem; position: relative; }
    a.whats {
      position: relative; display: inline-flex; align-items: center; gap: 10px;
      background: linear-gradient(135deg, var(--gold), var(--gold-soft) 55%, var(--gold));
      color: var(--navy-deep); font-weight: 800; font-size: 1.02rem; text-decoration: none;
      padding: 15px 30px; border-radius: 999px; box-shadow: 0 14px 34px rgba(212,175,55,.35);
      transition: transform .15s ease, box-shadow .15s ease;
    }
    a.whats:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 18px 42px rgba(212,175,55,.45); }
    .wrap { max-width: 940px; margin: 0 auto; padding: 0 20px 72px; }

    /* ── as 3 PORTAS (refrativa | catarata | trifocal) ── */
    .doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: -78px; position: relative; z-index: 2; }
    a.door {
      display: block; background: #fff; border: 1px solid #e4e9f2; border-radius: 18px;
      padding: 26px 22px 22px; text-decoration: none; color: inherit; text-align: center;
      box-shadow: 0 10px 30px rgba(12,27,64,.12);
      transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      position: relative; overflow: hidden;
    }
    a.door::after {
      content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px;
      background: linear-gradient(90deg, var(--gold), var(--gold-soft), var(--gold));
      opacity: 0; transition: opacity .16s ease;
    }
    a.door:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(21,44,97,.18); border-color: var(--gold-mid); }
    a.door:hover::after { opacity: 1; }
    a.door .emoji { font-size: 2.1rem; display: block; margin-bottom: 10px; }
    a.door strong { font-family: 'Cinzel', serif; display: block; color: var(--navy); font-size: 1.06rem; letter-spacing: .02em; margin-bottom: 6px; }
    a.door span { font-size: .9rem; color: #5b6779; display: block; }
    a.door em { display: inline-block; margin-top: 12px; font-style: normal; font-size: .82rem; font-weight: 700; color: var(--gold-dark); }

    h2 {
      font-family: 'Cinzel', serif; color: var(--navy); font-size: 1.05rem;
      letter-spacing: .06em; text-transform: uppercase; margin: 40px 0 14px;
      display: flex; align-items: center; gap: 10px;
    }
    h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold-mid), transparent); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    a.card {
      display: block; background: #fff; border: 1px solid #e4e9f2; border-radius: 14px;
      padding: 18px 18px 16px; text-decoration: none; color: inherit;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    a.card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(21,44,97,.10); border-color: var(--gold-mid); }
    a.card strong { display: block; color: var(--navy); font-size: 1.02rem; margin-bottom: 4px; }
    a.card span { font-size: .88rem; color: #5b6779; }
    .empty { text-align: center; color: #5b6779; padding: 46px 0 10px; }
    footer { text-align: center; padding: 26px 16px 40px; color: #7c8698; font-size: .82rem; }
    @media (prefers-reduced-motion: reduce) { a.door, a.card, a.whats { transition: none; } }
  </style>
</head>
<body>
  <div class="hero">
    <img src="/brand-assets/cevico-logo-dark-bg.png" alt="CEVICO — Cuidados Oculares">
    <p><%= @hub['tagline'].presence || 'Tecnologia de ponta, acolhimento humano e clareza visual. Comece por aqui: escolha o seu caminho ou fale direto com a gente.' %></p>
    <% if @hub_whatsapp %>
      <a class="whats" href="<%= @hub_whatsapp %>" rel="noopener">💬 Falar com a CEVICO no WhatsApp</a>
    <% end %>
  </div>

  <div class="wrap">
    <%# ── as 3 portas: página publicada quando existe; senão, WhatsApp com o assunto ── %>
    <div class="doors">
      <% @doors.each do |door| %>
        <% href = if door[:page_slug]
                    "/#{door[:page_slug]}"
                  elsif @hub['whatsapp'].present?
                    "https://wa.me/#{@hub['whatsapp']}?text=#{ERB::Util.url_encode(door[:whats])}"
                  end %>
        <% next if href.blank? %>
        <a class="door" href="<%= href %>" rel="noopener">
          <span class="emoji"><%= door[:emoji] %></span>
          <strong><%= door[:title] %></strong>
          <span><%= door[:text] %></span>
          <em><%= door[:page_slug] ? 'Conhecer →' : 'Falar no WhatsApp →' %></em>
        </a>
      <% end %>
    </div>

    <% if @pages_by_category.blank? %>
      <p class="empty">Os conteúdos estão sendo preparados. Volte em breve. 😊</p>
    <% else %>
      <% CevicoPage::CATEGORIES.each do |key, label| %>
        <% pages = @pages_by_category[key] %>
        <% next if pages.blank? %>
        <h2><%= label %></h2>
        <div class="cards">
          <% pages.each do |page| %>
            <a class="card" href="/<%= page.slug %>">
              <strong><%= page.title %></strong>
              <span><%= page.subtitle.presence || page.meta_description %></span>
            </a>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <footer>CEVICO — Cuidados Oculares</footer>

  <%# rastreio do hub: origem viaja pras páginas; WhatsApp ganha Protocolo %>
  <%= render 'cevico_pages/tracking_snippet', page: nil %>
</body>
</html>
