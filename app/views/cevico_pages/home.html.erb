<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CEVICO — Cuidados Oculares | Conteúdos e orientações</title>
  <meta name="description" content="Orientações oficiais da CEVICO — Cuidados Oculares: procedimentos, preparo para consultas e cirurgias e cuidados do pós-operatório.">
  <link rel="canonical" href="<%= Cevico::PublicSite.base_url %>/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="CEVICO — Cuidados Oculares">
  <meta property="og:description" content="Orientações oficiais da CEVICO: procedimentos, preparo e pós-operatório.">
  <meta property="og:site_name" content="CEVICO — Cuidados Oculares">
  <meta property="og:url" content="<%= Cevico::PublicSite.base_url %>/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&display=swap" rel="stylesheet">
  <style>
    /* Identidade CEVICO: azul marinho EXATO do logo (#152C61) + dourado */
    :root { --navy: #152C61; --navy-deep: #0C1B40; --brand: #0F5FA6; --gold: #D4AF37; --gold-soft: #F4DE8E; --gold-dark: #8A6620; --gold-mid: #C9A24B; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1a2333; background: #f6f8fb; line-height: 1.65;
    }
    .hero {
      background: linear-gradient(160deg, var(--navy-deep) 0%, var(--navy) 55%, var(--brand) 100%);
      color: #fff; padding: 56px 20px 64px; text-align: center; position: relative; overflow: hidden;
    }
    .hero::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px;
      background: linear-gradient(90deg, var(--gold), var(--gold-soft), var(--gold));
    }
    .hero img { max-width: 280px; width: 70%; height: auto; margin-bottom: 18px; }
    .hero p { opacity: .85; max-width: 560px; margin: 0 auto; font-size: 1.02rem; }
    .wrap { max-width: 880px; margin: 0 auto; padding: 40px 20px 72px; }
    h2 {
      font-family: 'Cinzel', serif; color: var(--navy); font-size: 1.05rem;
      letter-spacing: .06em; text-transform: uppercase; margin: 34px 0 14px;
      display: flex; align-items: center; gap: 10px;
    }
    h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold-mid), transparent); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    a.card {
      display: block; background: #fff; border: 1px solid #e4e9f2; border-radius: 14px;
      padding: 18px 18px 16px; text-decoration: none; color: inherit;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    a.card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(21,44,97,.10); border-color: var(--gold-mid); }
    a.card strong { display: block; color: var(--navy); font-size: 1.02rem; margin-bottom: 4px; }
    a.card span { font-size: .88rem; color: #5b6779; }
    .empty { text-align: center; color: #5b6779; padding: 60px 0; }
    footer { text-align: center; padding: 26px 16px 40px; color: #7c8698; font-size: .82rem; }
  </style>
</head>
<body>
  <div class="hero">
    <img src="/brand-assets/cevico-logo-dark-bg.png" alt="CEVICO — Cuidados Oculares">
    <p>Orientações oficiais da CEVICO: procedimentos, preparo para consultas e cirurgias e cuidados do pós-operatório.</p>
  </div>

  <div class="wrap">
    <% if @pages_by_category.blank? %>
      <p class="empty">Os conteúdos estão sendo preparados. Volte em breve. 😊</p>
    <% else %>
      <% CevicoPage::CATEGORIES.each do |key, label| %>
        <% pages = @pages_by_category[key] %>
        <% next if pages.blank? %>
        <h2><%= label %></h2>
        <div class="cards">
          <% pages.each do |page| %>
            <a class="card" href="/<%= page.slug %>">
              <strong><%= page.title %></strong>
              <span><%= page.subtitle.presence || page.meta_description %></span>
            </a>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <footer>CEVICO — Cuidados Oculares</footer>
</body>
</html>
