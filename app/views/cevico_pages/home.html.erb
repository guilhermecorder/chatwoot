<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# rodada 334: no domínio de uma EMPRESA, o hub fala o nome dela (@company); sem empresa, a CEVICO de sempre %>
  <% brand = @company ? @company.name : 'CEVICO — Cuidados Oculares' %>
  <% brand_desc = @company ? [@company.tagline.presence, @company.offers.presence].compact.join(' ') : 'CEVICO — Cuidados Oculares: cirurgia refrativa, cirurgia de catarata e lentes trifocais. Tecnologia de ponta, acolhimento humano e clareza visual.' %>
  <title><%= brand %> | Comece por aqui</title>
  <meta name="description" content="<%= @hub['tagline'].presence || brand_desc %>">
  <link rel="canonical" href="<%= Cevico::PublicSite.base_url %>/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= brand %>">
  <meta property="og:description" content="<%= @hub['tagline'].presence || (@company ? brand_desc : 'Cirurgia refrativa, catarata e lentes trifocais — comece por aqui.') %>">
  <meta property="og:site_name" content="<%= brand %>">
  <meta property="og:url" content="<%= Cevico::PublicSite.base_url %>/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&display=swap" rel="stylesheet">
  <style>
    /* Identidade CEVICO: azul marinho EXATO do logo (#152C61) + dourado */
    :root { --navy: #152C61; --navy-deep: #0C1B40; --brand: #0F5FA6; --gold: #D4AF37; --gold-soft: #F4DE8E; --gold-dark: #8A6620; --gold-mid: #C9A24B; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1a2333; background: #f6f8fb; line-height: 1.65;
    }
    .hero {
      background: linear-gradient(160deg, var(--navy-deep) 0%, var(--navy) 55%, var(--brand) 100%);
      color: #fff; padding: 56px 20px 130px; text-align: center; position: relative; overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: -40% -20% auto; height: 130%;
      background: radial-gradient(ellipse at 50% 0%, rgba(212,175,55,.14), transparent 60%);
      pointer-events: none;
    }
    .hero img { max-width: 280px; width: 70%; height: auto; margin-bottom: 18px; position: relative; }
    .hero p { opacity: .88; max-width: 600px; margin: 0 auto 26px; font-size: 1.05rem; position: relative; }
    a.whats {
      position: relative; display: inline-flex; align-items: center; gap: 10px;
      background: linear-gradient(135deg, var(--gold), var(--gold-soft) 55%, var(--gold));
      color: var(--navy-deep); font-weight: 800; font-size: 1.02rem; text-decoration: none;
      padding: 15px 30px; border-radius: 999px; box-shadow: 0 14px 34px rgba(212,175,55,.35);
      transition: transform .15s ease, box-shadow .15s ease;
    }
    a.whats:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 18px 42px rgba(212,175,55,.45); }
    .wrap { max-width: 940px; margin: 0 auto; padding: 0 20px 72px; }

    /* ── as 3 PORTAS (refrativa | catarata | trifocal) ── */
    .doors { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: -78px; position: relative; z-index: 2; }
    a.door {
      display: block; background: #fff; border: 1px solid #e4e9f2; border-radius: 18px;
      padding: 26px 22px 22px; text-decoration: none; color: inherit; text-align: center;
      box-shadow: 0 10px 30px rgba(12,27,64,.12);
      transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
      position: relative; overflow: hidden;
    }
    a.door::after {
      content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px;
      background: linear-gradient(90deg, var(--gold), var(--gold-soft), var(--gold));
      opacity: 0; transition: opacity .16s ease;
    }
    a.door:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(21,44,97,.18); border-color: var(--gold-mid); }
    a.door:hover::after { opacity: 1; }
    a.door .emoji { font-size: 2.1rem; display: block; margin-bottom: 10px; }
    a.door strong { font-family: 'Cinzel', serif; display: block; color: var(--navy); font-size: 1.06rem; letter-spacing: .02em; margin-bottom: 6px; }
    a.door span { font-size: .9rem; color: #5b6779; display: block; }
    a.door em { display: inline-block; margin-top: 12px; font-style: normal; font-size: .82rem; font-weight: 700; color: var(--gold-dark); }

    h2 {
      font-family: 'Cinzel', serif; color: var(--navy); font-size: 1.05rem;
      letter-spacing: .06em; text-transform: uppercase; margin: 40px 0 14px;
      display: flex; align-items: center; gap: 10px;
    }
    h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold-mid), transparent); }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    a.card {
      display: block; background: #fff; border: 1px solid #e4e9f2; border-radius: 14px;
      padding: 18px 18px 16px; text-decoration: none; color: inherit;
      transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    a.card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(21,44,97,.10); border-color: var(--gold-mid); }
    a.card strong { display: block; color: var(--navy); font-size: 1.02rem; margin-bottom: 4px; }
    a.card span { font-size: .88rem; color: #5b6779; }
    .empty { text-align: center; color: #5b6779; padding: 46px 0 10px; }
    .about { text-align: center; padding: 36px 0 0; }
    .about h2 { justify-content: center; }
    .about h2::after { display: none; }
    .about p { max-width: 640px; margin: 0 auto; color: #3d4756; }
    .about .links { margin-top: 16px; display: flex; gap: 22px; justify-content: center; flex-wrap: wrap; }
    .about .links a { color: var(--gold-dark); font-weight: 700; text-decoration: none; }
    .about .links a:hover { text-decoration: underline; }
    footer { text-align: center; padding: 26px 16px 40px; color: #7c8698; font-size: .82rem; }
    @media (prefers-reduced-motion: reduce) { a.door, a.card, a.whats { transition: none; } }
    /* ── 29/10: raiz da CLÍNICA = "linktree" por queixa ── */
    body.lt-body { background: linear-gradient(170deg, var(--navy-deep) 0%, var(--navy) 60%, var(--brand) 100%); min-height: 100vh; color: #fff; }
    .lt { max-width: 520px; margin: 0 auto; padding: 44px 20px 56px; text-align: center; }
    .lt img { max-width: 250px; width: 64%; height: auto; }
    .lt .brandline { margin: 14px auto 0; font-size: .92rem; opacity: .78; max-width: 420px; }
    .lt .tag { margin: 18px auto 26px; max-width: 420px; font-size: 1.06rem; line-height: 1.5; opacity: .92; }
    .lt .tag strong { display: block; font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em; color: #fff; margin-bottom: 6px; }
    .lt-links { display: grid; gap: 12px; margin: 0 0 22px; }
    a.lt-btn {
      display: grid; grid-template-columns: 52px 1fr 20px; align-items: center; gap: 14px; text-align: left;
      background: rgba(255,255,255,.97); color: inherit; border: 1px solid rgba(255,255,255,.8); border-radius: 22px; padding: 14px 16px;
      text-decoration: none; box-shadow: 0 12px 30px -8px rgba(5,12,32,.45), inset 0 1px 0 #fff;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    a.lt-btn:hover { transform: translateY(-2px); box-shadow: 0 18px 38px -8px rgba(5,12,32,.55), inset 0 1px 0 #fff; }
    a.lt-btn:active { transform: scale(.98); }
    /* ícone de app do iPhone: squircle com degradê dopamina e ícone de linha branco (= .cv-icon do sistema) */
    .lt-ico {
      width: 52px; height: 52px; border-radius: 15px; display: inline-flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--c1), var(--c2)); color: #fff;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.45), inset 0 -6px 12px rgba(0,0,0,.12), 0 6px 14px -6px var(--c2);
    }
    .lt-ico svg, .lt-go svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .lt-ico svg { width: 26px; height: 26px; }
    a.lt-btn strong { display: block; color: #1d1d1f; font-size: 1.08rem; font-weight: 700; letter-spacing: -.01em; }
    a.lt-btn span.txt { display: block; color: #6e6e73; font-size: .87rem; line-height: 1.35; margin-top: 2px; }
    .lt-go { color: #c7c7cc; display: inline-flex; }
    .lt-go svg { width: 20px; height: 20px; }
    /* WhatsApp: cartão BRANCO como os outros, com o ícone verde do WhatsApp (29/10: sem botão dourado) */
    a.lt-btn.lt-wa-btn { margin-top: 0; }
    a.lt-btn.lt-wa-btn strong { color: #16a34a; }
    .lt .foot { margin-top: 30px; font-size: .84rem; opacity: .8; line-height: 1.6; }
    .lt .foot a { color: var(--gold-soft); font-weight: 700; text-decoration: none; }
    .lt .foot a:hover { text-decoration: underline; }
    @media (prefers-reduced-motion: reduce) { a.lt-btn { transition: none; } }
  </style>
</head>
<body class="<%= @company ? '' : 'lt-body' %>">
<% if @company %>
  <div class="hero">
    <% if @company %>
      <h1 style="margin:0 0 8px;font-size:2rem"><%= @company.name %></h1>
    <% else %>
      <img src="/brand-assets/cevico-logo-dark-bg.png" alt="CEVICO — Cuidados Oculares">
    <% end %>
    <p><%= @hub['tagline'].presence || (@company ? "#{brand_desc.presence || 'Comece por aqui'}: fale direto com a gente." : 'Tecnologia de ponta, acolhimento humano e clareza visual. Comece por aqui: escolha o seu caminho ou fale direto com a gente.') %></p>
    <% if @hub_whatsapp %>
      <a class="whats" href="<%= @hub_whatsapp %>" rel="noopener">💬 Falar com a <%= @company ? @company.name : 'CEVICO' %> no WhatsApp</a>
    <% end %>
  </div>

  <div class="wrap">
    <%# ── as 3 portas: página publicada quando existe; senão, WhatsApp com o assunto ── %>
    <div class="doors">
      <% @doors.each do |door| %>
        <% href = if door[:page_slug]
                    "/#{door[:page_slug]}"
                  elsif @hub['whatsapp'].present?
                    "https://wa.me/#{@hub['whatsapp']}?text=#{ERB::Util.url_encode(door[:whats])}"
                  end %>
        <% next if href.blank? %>
        <a class="door" href="<%= href %>" rel="noopener">
          <span class="emoji"><%= door[:emoji] %></span>
          <strong><%= door[:title] %></strong>
          <span><%= door[:text] %></span>
          <em><%= door[:page_slug] ? 'Conhecer →' : 'Falar no WhatsApp →' %></em>
        </a>
      <% end %>
    </div>

    <% if @pages_by_category.blank? %>
      <p class="empty">Os conteúdos estão sendo preparados. Volte em breve. 😊</p>
    <% else %>
      <% CevicoPage::CATEGORIES.each do |key, label| %>
        <% pages = @pages_by_category[key] %>
        <% next if pages.blank? %>
        <h2><%= label %></h2>
        <div class="cards">
          <% pages.each do |page| %>
            <a class="card" href="/<%= page.slug %>">
              <strong><%= page.title %></strong>
              <span><%= page.subtitle.presence || page.meta_description %></span>
            </a>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <footer><%= brand %></footer>
<% else %>
  <%# ── 29/10: raiz da CLÍNICA = "linktree" por queixa. Nada de catálogo de
      páginas: a pessoa toca no que sente e cai na página certa; quem não
      sabe fala no WhatsApp. O institucional fica no site oficial. ── %>
  <% lt_icons = {
       'glasses' => '<circle cx="6" cy="15" r="4"/><circle cx="18" cy="15" r="4"/><path d="M14 15a2 2 0 0 0-2-2 2 2 0 0 0-2 2"/><path d="M2.5 13 5 7c.7-1.3 1.4-2 3-2"/><path d="M21.5 13 19 7c-.7-1.3-1.5-2-3-2"/>',
       'scan-eye' => '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="1"/><path d="M18.944 12.33a1 1 0 0 0 0-.66 7.5 7.5 0 0 0-13.888 0 1 1 0 0 0 0 .66 7.5 7.5 0 0 0 13.888 0"/>',
       'book-open' => '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
       'eye' => '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>'
     } %>
  <main class="lt">
    <img src="/brand-assets/cevico-logo-dark-bg.png" alt="CEVICO — Cuidados Oculares">
    <% if @hub['tagline'].present? %><p class="brandline"><%= @hub['tagline'] %></p><% end %>
    <p class="tag"><strong>O que você sente?</strong>Toque no seu caso e veja o caminho — ou fale direto com a gente.</p>
    <nav class="lt-links" aria-label="Escolha o seu caso">
      <% @doors.each do |door| %>
        <% href = if door[:page_slug]
                    "/#{door[:page_slug]}"
                  elsif @hub['whatsapp'].present?
                    "https://wa.me/#{@hub['whatsapp']}?text=#{ERB::Util.url_encode(door[:whats])}"
                  end %>
        <% next if href.blank? %>
        <a class="lt-btn" href="<%= href %>" rel="noopener">
          <span class="lt-ico" style="--c1: <%= door[:tint][0] %>; --c2: <%= door[:tint][1] %>" aria-hidden="true"><svg viewBox="0 0 24 24"><%= lt_icons[door[:icon]].to_s.html_safe %></svg></span>
          <span><strong><%= door[:title] %></strong><span class="txt"><%= door[:text] %></span></span>
          <span class="lt-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></span>
        </a>
      <% end %>
    </nav>
    <% if @hub_whatsapp %>
      <nav class="lt-links" aria-label="Falar no WhatsApp">
        <a class="lt-btn lt-wa-btn" href="<%= @hub_whatsapp %>" rel="noopener">
          <span class="lt-ico" style="--c1: #4ade80; --c2: #16a34a" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><g transform="translate(7.3 7.3) scale(.4)" stroke-width="4.5"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></g></svg></span>
          <span><strong>Falar no WhatsApp</strong><span class="txt">Não sei qual é o meu caso</span></span>
          <span class="lt-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></span>
        </a>
      </nav>
    <% end %>
    <p class="foot">Clínica oftalmológica em São Paulo · Paulista e Tatuapé<br>
      <a href="https://cevico.com.br" rel="noopener">Site institucional →</a></p>
  </main>
<% end %>

  <%# rastreio do hub: origem viaja pras páginas; WhatsApp ganha Protocolo %>
  <%= render 'cevico_pages/analytics_snippet', page: nil %>
  <%= render 'cevico_pages/tracking_snippet', page: nil %>
</body>
</html>
