# ============================================================
# Sistema CEVICO — Variáveis de Produção (EasyPanel)
# Copie este arquivo, preencha os valores e cole no EasyPanel
# ============================================================

# ── Aplicação ────────────────────────────────────────────────
SECRET_KEY_BASE=                    # gere com: openssl rand -hex 64
FRONTEND_URL=https://app.cevico.com.br
INSTALLATION_NAME=CEVICO S.I
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
INSTALLATION_ENV=docker

# ── Banco de dados ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=                  # senha forte, ex: openssl rand -hex 32

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:SENHA_REDIS@redis:6379
REDIS_PASSWORD=                     # mesma senha usada no REDIS_URL acima

# ── E-mail (SMTP) ────────────────────────────────────────────
# Pode deixar em branco por enquanto e configurar depois
MAILER_SENDER_EMAIL=noreply@cevico.com.br
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=cevico.com.br
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ── Storage ──────────────────────────────────────────────────
ACTIVE_STORAGE_SERVICE=local        # troque por 's3' se quiser usar AWS S3

# ── Captain (IA) — preencha quando for ativar ────────────────
CAPTAIN_OPEN_AI_API_KEY=
CAPTAIN_OPEN_AI_MODEL=gpt-4o
CAPTAIN_OPEN_AI_ENDPOINT=           # deixe vazio para usar padrão da OpenAI

# ── Integrações CRM ──────────────────────────────────────────
# (configuradas pela interface do sistema, não precisa preencher aqui)
